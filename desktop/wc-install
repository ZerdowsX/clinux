#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Install the running live system (booted from the ISO) onto a disk.
#
#   wc-install /dev/sdX
#
# ALL DATA ON THE DISK IS ERASED. The disk gets a GPT with an EFI system
# partition, a BIOS boot partition and an ext4 root, and GRUB for both UEFI
# and legacy BIOS. Progress is printed as "STEP <percent> <text>" lines for
# the Water Candy installer window.
set -eu

DEV=${1:-}
SRC=/live/squash
TARGET=/mnt/wc-target

# Progress goes to fd 3 when the installer window passes one.
if { true >&3; } 2>/dev/null; then
	exec 4>&3
else
	exec 4>&1
fi

step() {
	echo "STEP $1 $2" >&4
}

fail() {
	echo "ERROR $*" >&4
	echo "ERROR $*" >&2
	exit 1
}

[ "$(id -u)" -eq 0 ] || fail "must run as root"
[ -b "$DEV" ] || fail "$DEV is not a disk"
[ -d "$SRC/etc" ] || fail "not running from the live system ($SRC is missing)"
grep -q "^$DEV" /proc/mounts && fail "$DEV is in use"

case "$DEV" in
*[0-9]) P=${DEV}p ;;	# nvme0n1p1, mmcblk0p1
*) P=$DEV ;;		# sda1, vda1
esac

cleanup() {
	for m in dev/pts dev proc sys boot/efi ""; do
		umount "$TARGET/$m" 2>/dev/null || true
	done
}
trap cleanup EXIT

step 2 "Partitioning $DEV"
wipefs -a -q "$DEV"
sfdisk -q --wipe always "$DEV" <<EOF
label: gpt
size=512MiB, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B, name="EFI"
size=1MiB, type=21686148-6449-6E6F-744E-656564454649, name="BIOS"
type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name="WaterCandy"
EOF
blockdev --rereadpt "$DEV" 2>/dev/null || true
udevadm settle 2>/dev/null || sleep 2

step 6 "Creating file systems"
mkfs.vfat -F 32 -n EFI "${P}1" >/dev/null
mkfs.ext4 -q -F -L WaterCandy "${P}3"

mkdir -p "$TARGET"
mount "${P}3" "$TARGET"
mkdir -p "$TARGET/boot/efi"
mount "${P}1" "$TARGET/boot/efi"

step 10 "Copying files"
TOTAL=$(du -sxk "$SRC" | cut -f1)
cp -a "$SRC/." "$TARGET/" &
CP=$!
while kill -0 "$CP" 2>/dev/null; do
	DONE=$(du -sxk "$TARGET" 2>/dev/null | cut -f1)
	step $((10 + 75 * DONE / (TOTAL + 1))) "Copying files"
	sleep 3
done
wait "$CP" || fail "copying files failed"
rm -f "$TARGET/etc/clinux-live"

step 86 "Configuring the system"
ROOT_UUID=$(blkid -s UUID -o value "${P}3")
ROOT_PARTUUID=$(blkid -s PARTUUID -o value "${P}3")
EFI_UUID=$(blkid -s UUID -o value "${P}1")
cat > "$TARGET/etc/fstab" <<EOF
UUID=$ROOT_UUID / ext4 defaults 0 1
UUID=$EFI_UUID /boot/efi vfat umask=0077 0 1
EOF

step 90 "Installing the boot loader"
for m in dev dev/pts proc sys; do
	mount --bind "/$m" "$TARGET/$m"
done
chroot "$TARGET" grub-install --target=x86_64-efi --efi-directory=/boot/efi \
	--boot-directory=/boot --removable --no-nvram >/dev/null 2>&1 ||
	fail "installing GRUB for UEFI failed"
chroot "$TARGET" grub-install --target=i386-pc --boot-directory=/boot "$DEV" \
	>/dev/null 2>&1 || echo "WARNING GRUB for legacy BIOS was not installed"

cat > "$TARGET/boot/grub/grub.cfg" <<EOF
set timeout=3
set default=0
insmod part_gpt
insmod ext2
insmod all_video
search --no-floppy --fs-uuid --set=root $ROOT_UUID

menuentry "Water Candy" {
	linux /boot/vmlinuz-clinux root=PARTUUID=$ROOT_PARTUUID rw quiet
}
menuentry "Water Candy (safe graphics)" {
	linux /boot/vmlinuz-clinux root=PARTUUID=$ROOT_PARTUUID rw nomodeset
}
EOF

step 98 "Finishing"
sync
step 100 "Done"
