# Help: Kernel support needed to run an X11 desktop (Xorg + XFCE)
#
# Usage (x86_64, QEMU/KVM or real hardware):
#   make x86_64_defconfig kvm_guest.config x11_desktop.config
#
# Userspace (Xorg, XFCE, display manager) is not part of the kernel;
# see desktop/README.md for building a root filesystem with them.

# Base userspace requirements (systemd, D-Bus, Xorg)
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CGROUPS=y
CONFIG_FHANDLE=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_INOTIFY_USER=y
CONFIG_SECCOMP=y
CONFIG_DMIID=y
CONFIG_UNIX=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_AUTOFS_FS=y
CONFIG_EXT4_FS=y
CONFIG_FUSE_FS=y

# Graphics: DRM/KMS for the Xorg modesetting driver
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_QXL=y
CONFIG_DRM_I915=y

# Console on the framebuffer
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Input: evdev is what xf86-input-libinput uses
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_VIRTIO_INPUT=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# Sound (optional, for the XFCE volume applet)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_VIRTIO=y
